{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-reviews",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "DinkusKit Reviews",
  "description": "Star ratings and reviews from your buyers, for DinkusKit Commerce stores on EmDash. Records stay in your store.",
  "keywords": ["reviews", "ratings", "product reviews", "ecommerce"],
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://dinkuskit.com"
  },
  "security": {
    "url": "https://github.com/dinkuskit/reviews/security"
  },
  "repo": "https://github.com/dinkuskit/reviews",
  "capabilities": ["email:send"],
  "storage": {
    "reviews": {
      "indexes": ["productId", "status", "createdAt", ["productId", "status"]],
      "uniqueIndexes": [["orderId", "productId"]]
    },
    "shipped": {
      "indexes": ["state", "shippedAt", "askedAt"],
      "uniqueIndexes": []
    },
    "ratings": {
      "indexes": [],
      "uniqueIndexes": []
    }
  },
  "admin": {
    "pages": [
      { "path": "/reviews", "label": "Reviews", "icon": "star" }
    ]
  }
}
